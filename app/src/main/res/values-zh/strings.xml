    <string name="guard_label">被动守护</string>
    <string name="guard_active">守护进程运行中</string>
    <string name="guard_inactive">已停止</string>
    <string name="guard_desc">只需要 Root；后台进程在 adbd 被杀后会自动重新拉起。</string>

    <string name="adb_label">无线 ADB</string>
    <string name="adb_active">已启用</string>
    <string name="adb_inactive">已禁用</string>
    <string name="adb_desc">开启/关闭无线 ADB，监听端口固定为 5555。</string>
