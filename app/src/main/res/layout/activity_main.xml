<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg_dark"
        android:paddingHorizontal="16dp"
        app:contentInsetStartWithNavigation="0dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ADBLive"
            android:textColor="@color/teal"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.03" />
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_refresh"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/refresh"
            app:tint="@color/teal" />
    </androidx.appcompat.widget.Toolbar>

    <ProgressBar
        android:id="@+id/progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:indeterminate="true"
        android:indeterminateTint="@color/teal"
        android:visibility="gone" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Connection info -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardConn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="@color/card_bg_alt"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_border_off"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/conn_label"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:letterSpacing="0.1" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/ip_label"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp" />
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/port_label"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:layout_marginStart="32dp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="2dp"
                            android:gravity="center_vertical">
                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />
                            <TextView
                                android:id="@+id/tvIp"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="@color/on_teal_container"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace" />
                            <TextView
                                android:id="@+id/tvPort"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="5555"
                                android:textColor="@color/on_teal_container"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:fontFamily="monospace"
                                android:layout_marginStart="36dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ADB card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAdb"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_border_off"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <ImageView
                                android:id="@+id/icAdb"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_wifi"
                                android:background="@drawable/bg_icon_circle_off"
                                android:padding="8dp" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/adb_label"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginStart="12dp" />
                            <TextView
                                android:id="@+id/tvAdb"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/status_checking"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                android:gravity="end"
                                android:layout_marginEnd="10dp" />
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/swAdb"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textOn=" "
                                android:textOff=" "
                                android:scaleX="0.72"
                                android:scaleY="0.72"
                                android:minHeight="0dp"
                                android:minWidth="0dp"
                                app:thumbTint="@color/teal"
                                app:trackTint="@color/text_secondary" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/adb_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:layout_marginStart="48dp"
                            android:layout_marginTop="0dp" />
                        <TextView
                            android:id="@+id/btnDevOptions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dev_options"
                            android:textColor="@color/teal"
                            android:textSize="12sp"
                            android:paddingTop="4dp"
                            android:paddingBottom="2dp"
                            android:paddingStart="2dp"
                            android:paddingEnd="8dp"
                            android:layout_gravity="end"
                            android:background="?attr/selectableItemBackground" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Active shield card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardXposed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_border_off"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <ImageView
                                android:id="@+id/icShield"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_shield"
                                android:background="@drawable/bg_icon_circle_off"
                                android:padding="8dp" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/shield_label"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginStart="12dp" />
                            <TextView
                                android:id="@+id/tvXposed"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/status_checking"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                android:gravity="end"
                                android:layout_marginEnd="10dp" />
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/swShield"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textOn=" "
                                android:textOff=" "
                                android:scaleX="0.72"
                                android:scaleY="0.72"
                                android:minHeight="0dp"
                                android:minWidth="0dp"
                                app:thumbTint="@color/teal"
                                app:trackTint="@color/text_secondary" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/shield_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:layout_marginStart="48dp"
                            android:layout_marginTop="0dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Passive guard card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGuard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_border_off"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <ImageView
                                android:id="@+id/icGuard"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_watchdog"
                                android:background="@drawable/bg_icon_circle_off"
                                android:padding="8dp" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/guard_label"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginStart="12dp" />
                            <TextView
                                android:id="@+id/tvGuard"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/status_checking"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                android:gravity="end"
                                android:layout_marginEnd="10dp" />
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/swGuard"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textOn=" "
                                android:textOff=" "
                                android:scaleX="0.72"
                                android:scaleY="0.72"
                                android:minHeight="0dp"
                                android:minWidth="0dp"
                                app:thumbTint="@color/teal"
                                app:trackTint="@color/text_secondary" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/guard_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:layout_marginStart="48dp"
                            android:layout_marginTop="0dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Root card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardRoot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_border_off"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <ImageView
                                android:id="@+id/icRoot"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_key"
                                android:background="@drawable/bg_icon_circle_off"
                                android:padding="8dp" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/root_label"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginStart="12dp" />
                            <TextView
                                android:id="@+id/tvRoot"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/status_checking"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                android:gravity="end"
                                android:layout_marginEnd="10dp" />
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/swRoot"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textOn=" "
                                android:textOff=" "
                                android:scaleX="0.72"
                                android:scaleY="0.72"
                                android:minHeight="0dp"
                                android:minWidth="0dp"
                                android:clickable="false"
                                android:focusable="false"
                                app:thumbTint="@color/teal"
                                app:trackTint="@color/text_secondary" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/root_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:layout_marginStart="48dp"
                            android:layout_marginTop="0dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Auto start card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBoot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_border_off"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="8dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <ImageView
                                android:id="@+id/icBoot"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:src="@drawable/ic_boot"
                                android:background="@drawable/bg_icon_circle_off"
                                android:padding="8dp" />
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/boot_label"
                                android:textColor="@color/text_primary"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:layout_marginStart="12dp" />
                            <TextView
                                android:id="@+id/tvBoot"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/status_checking"
                                android:textColor="@color/text_secondary"
                                android:textSize="13sp"
                                android:gravity="end"
                                android:layout_marginEnd="10dp" />
                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/swBoot"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textOn=" "
                                android:textOff=" "
                                android:scaleX="0.72"
                                android:scaleY="0.72"
                                android:minHeight="0dp"
                                android:minWidth="0dp"
                                app:thumbTint="@color/teal"
                                app:trackTint="@color/text_secondary" />
                        </LinearLayout>
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/boot_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:layout_marginStart="48dp"
                            android:layout_marginTop="0dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Log card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="@color/card_bg"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/log_label"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1" />
                        <TextView
                            android:id="@+id/tvLog"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:fontFamily="monospace"
                            android:layout_marginTop="4dp"
                            android:maxLines="8" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- About card (collapsed by default) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAbout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    app:cardBackgroundColor="@color/card_bg_alt"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/card_border_off"
                    app:strokeWidth="1dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/about_title"
                                android:textColor="@color/text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                            <TextView
                                android:id="@+id/tvAboutToggle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/about_expand"
                                android:textColor="@color/teal"
                                android:textSize="12sp"
                                android:padding="2dp"
                                android:background="?attr/selectableItemBackground" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvAboutDesc"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/about_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:lineSpacingMultiplier="1.2"
                            android:layout_marginTop="6dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="@color/text_secondary"
        android:textSize="11sp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:paddingTop="2dp"
        android:paddingBottom="6dp" />

</LinearLayout>
